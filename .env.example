# Copy to .env and adjust as needed. .env itself is gitignored.

# Path to the SQLite database file used by the app.
DATABASE_URL=./data/ev-charging-log.db

# Optional: base URL of a Nominatim (OpenStreetMap geocoding) instance, used for
# address autocomplete and GPS "use current location". Defaults to the public
# https://nominatim.openstreetmap.org instance if unset — only override this if
# self-hosting your own Nominatim.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
