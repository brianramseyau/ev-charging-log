{
	"name": "ev-charging-log",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && npm run assets:generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"theme:compile": "mkdir -p static/smui && smui-theme compile static/smui/smui.css -i src/theme && smui-theme compile static/smui/smui-dark.css -i src/theme/dark",
		"icons:generate": "node scripts/generate-icons.mjs",
		"assets:generate": "npm run theme:compile && npm run icons:generate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.62.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@smui/button": "^9.0.1",
		"@smui/card": "^9.0.1",
		"@smui/common": "^9.0.1",
		"@smui/data-table": "^9.0.1",
		"@smui/dialog": "^9.0.1",
		"@smui/drawer": "^9.0.1",
		"@smui/fab": "^9.0.1",
		"@smui/icon-button": "^9.0.1",
		"@smui/list": "^9.0.1",
		"@smui/menu": "^9.0.1",
		"@smui/select": "^9.0.1",
		"@smui/snackbar": "^9.0.1",
		"@smui/textfield": "^9.0.1",
		"@smui/top-app-bar": "^9.0.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"better-sqlite3": "^13.0.2",
		"exceljs": "^4.4.0",
		"sass": "^1.102.0",
		"smui-theme": "^9.0.1",
		"vite-plugin-pwa": "^1.3.0"
	}
}
